GOOGLE_API_KEY=your_google_api_key_here
PORT=3001

# OpenAI (Loka chat + hosted web lookup). Same key; not required for the API to boot.
# OPENAI_API_KEY=sk-...

# Optional. Set to off to disable live web lookup for hours, prices, and booking links.
# Uses the existing OPENAI_API_KEY via the Responses API (web_search_preview).
# LOKA_WEB_SEARCH=off

# Brevo transactional email (OTP) — use BREVO_API_KEY (xkeysib-...), not SMTP key
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Loka

# Instagram / TikTok import (Explore)
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# YTDLP_COOKIES_FROM_BROWSER=safari,chrome
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# INSTAGRAM_SCRAPER_API_KEY=  # defaults to RAPIDAPI_KEY
# INSTAGRAM_SCRAPER_API_HOST=instagram-scraper-api2.p.rapidapi.com
# INSTAGRAM_SCRAPER_API_URL=https://instagram-scraper-api2.p.rapidapi.com/v1/media_info